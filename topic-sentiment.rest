###############################################################################
# Topic Sentiment Analysis
#
# Análise de sentimento profunda de um tópico específico da audiência.
# Quando o usuário clica em "Sentimento" na UI, dispara uma análise
# que retorna: overall, emotional_map, drivers, tensões, dores, oportunidades.
#
# FLUXO:
#   1. GET  /sentiment          → primeira vez retorna "no_analysis"
#   2. POST /sentiment/refresh  → dispara análise em background (202)
#   3. GET  /sentiment          → durante processamento retorna "processing"
#   4. GET  /sentiment          → após ~2-3min retorna "ready" com dados
#
# NOTA: A análise é sob demanda (não automática). Só roda quando o
#       usuário solicita via POST refresh.
###############################################################################

@base_url = http://localhost:8000
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJiNWYzOTZhOC1iYmU2LTRkOWItOGI5OS1jMGE1ZTc3ZjgwNzEiLCJ0eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzcxNzA1MTA4fQ.fdFgKKP9QH2Aan5ZDvXagzii8YTOLYo-bFO6RYb6cN8

# IDs de exemplo — substitua pelos seus
@audience_id = e9458348-6cad-4ba6-bf3e-87674d035613
@topic_id = 13129258-589b-4c3a-b7ab-aaf8f7d46346

###############################################################################
# 1. CONSULTAR SENTIMENTO DE UM TÓPICO
###############################################################################

### Consultar sentimento (primeira vez → status: "no_analysis")
# Retorna o estado atual da análise de sentimento do tópico.
#
# Respostas possíveis:
#   - "no_analysis": Nenhuma análise existe. Use POST /refresh para iniciar.
#   - "processing":  Análise em andamento. Aguarde 2-3 minutos.
#   - "ready":       Análise pronta. Retorna dados completos (ver abaixo).
#   - "failed":      Análise falhou. Verifique error_message.
#
# Quando status = "ready", os campos retornados são:
#   - overall_sentiment:      {score, positive_ratio, negative_ratio, neutral_ratio}
#   - emotional_map:          [{emotion, intensity, percentage, example}]
#   - sentiment_by_community: [{community, positive, negative, neutral, dominant_emotion}]
#   - sentiment_by_subtopic:  [{subtopic, sentiment, score, key_driver}]
#   - sentiment_drivers:      {positive: [{driver, frequency, mentions, example_quote}], negative: [...]}
#   - tension_points:         [{topic, for_ratio, against_ratio, intensity, summary}]
#   - pain_points:            [{pain, severity, frequency, communities, verbatim}]
#   - sentiment_opportunities:[{opportunity, based_on, confidence, target_audience}]
#
GET {{base_url}}/audiences/{{audience_id}}/topics/{{topic_id}}/sentiment
content-type: application/json
Authorization: Bearer {{token}}

###############################################################################
# 2. DISPARAR ANÁLISE DE SENTIMENTO
###############################################################################

### Iniciar análise de sentimento (retorna 202 Accepted)
# Cria uma nova análise e a processa em background.
# Se já existe uma análise em processamento, retorna o status sem criar outra.
#
# O processamento envolve:
#   1. Coleta de posts das comunidades do tópico (~50 posts)
#   2. Filtragem por relevância ao tópico (keywords matching)
#   3. Coleta de comentários dos top 10 posts (20 comments cada)
#   4. Análise profunda de sentimento via LLM (8 dimensões)
#
# Tempo estimado: ~2-3 minutos (depende do rate limiting do Reddit)
#
# Resposta:
#   {status: "processing", message: "...", analysis_id: "uuid"}
#
POST {{base_url}}/audiences/{{audience_id}}/topics/{{topic_id}}/sentiment/refresh
content-type: application/json
Authorization: Bearer {{token}}

###############################################################################
# 3. CONSULTAR SENTIMENTO APÓS PROCESSAMENTO
###############################################################################

### Consultar sentimento (após ~2-3min → status: "ready")
# Mesma chamada do passo 1. Quando a análise termina, retorna os dados.
#
# Exemplo de resposta (resumido):
# {
#   "status": "ready",
#   "topic_name": "AI in Marketing",
#   "overall_sentiment": {
#     "score": "mixed",
#     "positive_ratio": 0.45,
#     "negative_ratio": 0.25,
#     "neutral_ratio": 0.30
#   },
#   "emotional_map": [
#     {"emotion": "enthusiasm", "intensity": "high", "percentage": 0.30, "example": "AI is transforming how we..."},
#     {"emotion": "anxiety", "intensity": "medium", "percentage": 0.20, "example": "Will AI replace marketers?"}
#   ],
#   "sentiment_by_community": [
#     {"community": "r/digital_marketing", "positive": 0.55, "negative": 0.15, "neutral": 0.30, "dominant_emotion": "enthusiasm"}
#   ],
#   "sentiment_by_subtopic": [
#     {"subtopic": "AI Content & Automation", "sentiment": "positive", "score": 0.72, "key_driver": "time savings"}
#   ],
#   "sentiment_drivers": {
#     "positive": [
#       {"driver": "Time savings", "frequency": "high", "mentions": 18, "example_quote": "AI saves me 10 hours a week..."}
#     ],
#     "negative": [
#       {"driver": "Job displacement fear", "frequency": "medium", "mentions": 9, "example_quote": "I worry that AI will..."}
#     ]
#   },
#   "tension_points": [
#     {"topic": "AI replacing human creativity", "for_ratio": 0.45, "against_ratio": 0.55, "intensity": "high", "summary": "Heated debate about..."}
#   ],
#   "pain_points": [
#     {"pain": "AI-generated content lacks authenticity", "severity": "high", "frequency": "medium", "communities": ["r/marketing"], "verbatim": "You can always tell when..."}
#   ],
#   "sentiment_opportunities": [
#     {"opportunity": "AI-human hybrid workflows", "based_on": "Strong demand for tools that augment rather than replace", "confidence": "high", "target_audience": "Marketing managers"}
#   ]
# }
#
GET {{base_url}}/audiences/{{audience_id}}/topics/{{topic_id}}/sentiment
content-type: application/json
Authorization: Bearer {{token}}

###############################################################################
# 4. TESTAR COM OUTROS TÓPICOS
###############################################################################

### Listar tópicos disponíveis (para pegar topic_id)
# Use este endpoint para descobrir os topic_ids disponíveis.
# Pegue o "id" de qualquer tópico e substitua em @topic_id acima.
#
GET {{base_url}}/audiences/{{audience_id}}/topics?limit=10&offset=0
content-type: application/json
Authorization: Bearer {{token}}

###############################################################################
# 5. CENÁRIOS DE ERRO
###############################################################################

### Tópico inexistente (→ 404)
GET {{base_url}}/audiences/{{audience_id}}/topics/00000000-0000-0000-0000-000000000000/sentiment
content-type: application/json
Authorization: Bearer {{token}}

### Audiência inexistente (→ 404)
GET {{base_url}}/audiences/00000000-0000-0000-0000-000000000000/topics/{{topic_id}}/sentiment
content-type: application/json
Authorization: Bearer {{token}}

### Sem autenticação (→ 401)
GET {{base_url}}/audiences/{{audience_id}}/topics/{{topic_id}}/sentiment
content-type: application/json
