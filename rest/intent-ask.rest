###############################################################################
# Intent Ask — Q&A com IA sobre categorias de intenção
#
# Permite ao usuário fazer perguntas livres sobre uma categoria de intenção
# e receber respostas baseadas nos dados de classificação de intenção
# (subcategories, keywords, patterns) + análise de temas (narrativas).
#
# PRÉ-REQUISITO: Intent Classification (Theme 02) precisa ter sido executada
#   com status "ready" para a janela desejada (week/month).
#   Se não foi executada, o agente responde com context_quality: "limited".
#
# FLUXO:
#   1. POST /themes/intents/{category}/ask → envia pergunta, recebe resposta (~3-5s)
#
# CONTEXTO RICO (context_quality: "rich"):
#   O agente recebe quando a classificação de intenção existe e está "ready".
#   Os labels do contexto variam por categoria:
#
#   pain_and_anger:
#     - PAIN & ANGER OVERVIEW, EMOTION BREAKDOWN, PAIN TOPIC KEYWORDS,
#       BEHAVIORAL PAIN PATTERNS, TOP SUBREDDITS FOR PAIN & ANGER
#
#   solution_request:
#     - SOLUTION REQUESTS OVERVIEW, SOLUTION TYPE BREAKDOWN, SOLUTION TOPIC KEYWORDS,
#       SOLUTION REQUEST PATTERNS, TOP SUBREDDITS FOR SOLUTION REQUESTS
#
#   Ambas incluem: SAMPLE POSTS + BROADER THEME CONTEXT (Theme 01)
#
# CONTEXTO LIMITADO (context_quality: "limited"):
#   Se a classificação NÃO foi executada, o agente responde com dados mínimos
#   (só nome da categoria e comunidades) + sugestão para executar a classificação.
#
# CACHE:
#   - Mesma pergunta na mesma categoria/janela retorna resposta cacheada (48h TTL)
#   - Campo "cached" na resposta indica se veio do cache
#
# CATEGORIAS SUPORTADAS:
#   - pain_and_anger
#   - solution_request
#   - Demais categorias retornam 400 com mensagem explicativa
#
# HISTÓRICO:
#   - Todas as perguntas/respostas são persistidas na tabela intent_ask_logs
###############################################################################

@base_url = http://localhost:8000
@token = REPLACE_WITH_JWT_TOKEN

# IDs de exemplo — substitua pelos seus
@audience_id = REPLACE_WITH_AUDIENCE_ID

###############################################################################
# 1. FAZER UMA PERGUNTA SOBRE PAIN & ANGER
###############################################################################

### Pergunta básica (janela semanal)
# Envia uma pergunta e recebe resposta baseada nos dados de intent classification.
#
# Resposta esperada (context_quality: "rich"):
# {
#   "answer": "Com base nos dados analisados, as principais frustrações...",
#   "context_quality": "rich",
#   "sources_used": ["intent_classification", "theme_analysis"],
#   "cached": false,
#   "intent_category": "pain_and_anger",
#   "suggestion": null,
#   "analysis_id": "uuid-da-analise"
# }
#
# Resposta esperada (context_quality: "limited"):
# {
#   "answer": "Com os dados disponíveis, posso informar que...",
#   "context_quality": "limited",
#   "sources_used": ["intent_metadata"],
#   "cached": false,
#   "intent_category": "pain_and_anger",
#   "suggestion": "Execute a classificação de intenções para obter respostas mais detalhadas...",
#   "analysis_id": null
# }
#
POST {{base_url}}/audiences/{{audience_id}}/themes/intents/pain_and_anger/ask?window=week
content-type: application/json
Authorization: Bearer {{token}}

{
  "question": "Quais são as principais frustrações dessa audiência?"
}

