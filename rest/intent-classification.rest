@audience_id = e9458348-6cad-4ba6-bf3e-87674d035613

###############################################################################
# 1. DISPARAR CLASSIFICAÇÃO DE INTENÇÕES (SEMANAL)
###############################################################################

### Iniciar classificação de intenções semanal (retorna 202 Accepted)
# Dispara classificação em background thread.
# Requer theme_analysis "ready" para a janela solicitada.
# Se já existe classificação com mesmo fingerprint, retorna status atual.
#
# Respostas:
#   - 202: Classificação iniciada
#     {status: "processing", analysis_id: "uuid", message: "..."}
#   - 200: Já existe (processing ou ready)
#     {status: "processing|already_exists", analysis_id: "uuid"}
#   - 400: Janela inválida ou sem theme_analysis ready
#   - 404: Audiência não encontrada
#   - 403: Acesso negado (não é dono da audiência)
#
POST {{base_url}}/audiences/{{audience_id}}/themes/intents/refresh?window=week
content-type: application/json
Authorization: Bearer {{token}}

###############################################################################
# 2. CONSULTAR CLASSIFICAÇÃO DE INTENÇÕES (SEMANAL)
###############################################################################

### Consultar resultado da classificação semanal
# Retorna a classificação mais recente para a janela solicitada.
#
# Respostas possíveis por status:
#   - "no_analysis": Nenhuma classificação existe. Use POST /refresh.
#   - "processing":  Classificação em andamento. Aguarde ~1-2 minutos.
#   - "ready":       Classificação pronta. Retorna categorias com contagens.
#   - "failed":      Classificação falhou. Verifique error_message.
#
# Quando status = "ready", cada intent retorna:
#   - category:       Nome interno da categoria (ex: advice_request)
#   - label:          Label para UI (ex: "Advice Requests")
#   - icon:           Ícone para UI (ex: "help-circle")
#   - post_count:     Total de posts nesta categoria
#   - percentage:     % do total de posts classificados
#   - description:    Descrição gerada por IA
#   - sample_posts:   [{title, subreddit, score}]
#   - top_subreddits: [{name, count}] — de quais comunidades vêm (pain_and_anger, solution_request)
#   - subcategories:  {key: count} — até 10 itens (pain_and_anger, solution_request)
#   - topic_keywords: {keyword: count} — até 10 palavras-chave (pain_and_anger, solution_request)
#   - pain_patterns:  [padrões agrupados] — pain_and_anger e solution_request (Issue #84, #100)
#   - rank:           Posição ordenada por post_count desc
#
# Para pain_and_anger, subcategories traz sentimentos agregados via LLM
# (ex: {frustration: 98, concern: 65, anger: 42}).
# topic_keywords traz tópicos agregados (ex: {dog: 85, behavior: 42}).
# pain_patterns agrupa posts em padrões comportamentais de dor via segunda chamada LLM.
#
# Para solution_request, subcategories traz tipos de solução buscados via LLM
# (ex: {tools: 12, automation: 8, templates: 5}).
# topic_keywords traz tópicos de solução (ex: {scheduling: 5, analytics: 4}).
# pain_patterns (mesmo campo) agrupa posts em padrões de busca de solução.
#
# Cada padrão (pain_patterns) contém:
#     - name:           Nome descritivo do padrão (5-10 palavras)
#     - emoji:          Emoji representando o tom
#     - post_count:     Quantidade de posts no padrão
#     - total_upvotes:  Soma de upvotes dos posts
#     - total_comments: Soma de comentários dos posts
#     - submissions:    [{title, body, subreddit, score, num_comments, permalink}]
#   Requer >= 3 posts na categoria. Se < 3, retorna [].
# Para demais categorias, subcategories/topic_keywords retornam {} e pain_patterns retorna [].
#
GET {{base_url}}/audiences/{{audience_id}}/themes/intents?window=week
content-type: application/json
Authorization: Bearer {{token}}

###############################################################################
# 3. DISPARAR CLASSIFICAÇÃO DE INTENÇÕES (MENSAL)
###############################################################################

### Iniciar classificação de intenções mensal
POST {{base_url}}/audiences/{{audience_id}}/themes/intents/refresh?window=month
content-type: application/json
Authorization: Bearer {{token}}

###############################################################################
# 4. CONSULTAR CLASSIFICAÇÃO DE INTENÇÕES (MENSAL)
###############################################################################

### Consultar resultado da classificação mensal
GET {{base_url}}/audiences/{{audience_id}}/themes/intents?window=month
content-type: application/json
Authorization: Bearer {{token}}

